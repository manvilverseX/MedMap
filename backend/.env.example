DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/medmap
# SECRET_KEY is required for security. Generate a strong random key for production.
SECRET_KEY=YOUR_SUPER_SECRET_KEY_PLACEHOLDER

# FRONTEND_ORIGIN is the URL of your deployed frontend. You can provide a comma-separated list.
# FRONTEND_ORIGIN=https://medmap.example.com

# INITIAL_ADMIN_PASSWORD is required for the first deployment when running seed.py
INITIAL_ADMIN_PASSWORD=<set-a-strong-password-before-seeding>

# Groq API Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY_PLACEHOLDER
GROQ_MODEL=openai/gpt-oss-120b
